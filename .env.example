# Secrets are read from the OS keychain (Settings -> Security) or from environment variables like these.
# They are never written to settings.json, the database or logs, and never sent to the AI model.
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
# Email over IMAP/SMTP (use an app-specific password, not your main password)
MRX_EMAIL_ADDRESS=
MRX_EMAIL_PASSWORD=
MRX_IMAP_HOST=
MRX_SMTP_HOST=
# Mastodon (token from your instance's Preferences -> Development)
MRX_MASTODON_URL=
MRX_MASTODON_TOKEN=
